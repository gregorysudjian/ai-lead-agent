# Copy this file to .env.local and fill in values.
# .env.local is gitignored and must never be committed.
# NOTHING here is connected yet -- these are placeholders for later phases.

# --- Provider selection -------------------------------------------------
# Which implementation to load. Keep these on "mock" until you have
# explicitly decided to enable a paid API.
# PLACES_PROVIDER=mock      # mock | google
# AI_PROVIDER=mock          # mock | anthropic

# --- Google Places (Phase 5, paid -- leave empty for now) ---------------
# Server-side only. NEVER prefix with NEXT_PUBLIC_.
# GOOGLE_PLACES_API_KEY=

# --- Anthropic (Phase 7, paid -- leave empty for now) -------------------
# ANTHROPIC_API_KEY=

# --- Supabase (Phase 6 -- leave empty for now) --------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
