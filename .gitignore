# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- Secrets: passwords, API keys, credentials -----------------------------
# Real values live only in .env.local on this machine. The example template,
# with empty placeholders, IS committed so others know what to set.
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
service-account*.json
/secrets.*
.npmrc
.netrc

# ---- Dependencies ----------------------------------------------------------
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtual environments and caches (scripts may use one locally)
venv/
.venv/
/env/
__pycache__/
*.py[cod]

# ---- Build output ----------------------------------------------------------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ---- Local data -------------------------------------------------------------
# The dev JSON lead store, ingested dataset slices, screenshots and backups.
# Large, regenerable, and full of real business records -- never committed.
/data/

# Supabase CLI scratch state (link metadata, version caches) -- machine-local
/supabase/.temp/

# ---- Tooling and OS ---------------------------------------------------------
.vercel
.DS_Store
Thumbs.db
.idea/
.claude/settings.local.json

# ---- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
